[Unit]
Description=Grafana Alloy — metrics collection agent
Documentation=https://grafana.com/docs/alloy/
After=network-online.target
Wants=network-online.target

[Service]
User=root
ExecStart=/usr/bin/alloy run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data
EnvironmentFile=/etc/alloy/env
Restart=always
RestartSec=5s

# Limit WAL disk usage to prevent unbounded growth when Grafana Cloud is unreachable
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
