server {
    listen 80;
    # Replace with your Oracle VPS domain or IP
    server_name jduel.com www.jduel.com;

    # Frontend static files
    root /var/www/jduel-frontend/dist;
    index index.html;

    # Security headers
    # Note: after running certbot, copy these into the generated HTTPS server block too.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # unsafe-inline required for MUI (emotion CSS-in-JS injects <style> tags at runtime)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://jduel.com wss://www.jduel.com; font-src 'self' data:; object-src 'none'; base-uri 'self';" always;

    # API endpoints -> FastAPI backend
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket -> FastAPI backend
    location /ws {
        proxy_pass http://127.0.0.1:8000;

        # WebSocket upgrade headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Request info
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeouts for WebSocket
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Health check
    location /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Static assets with long-term caching
    # Security headers must be repeated here — nginx add_header is not inherited
    # when a location block defines its own add_header directives.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA fallback - serves index.html for client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }
}
# Note: Certbot will append an HTTPS server block here when you run:
#   sudo certbot --nginx -d jduel.com -d www.jduel.com
