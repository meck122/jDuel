server {
    listen 80;
    # Replace with your Oracle VPS domain or IP
    server_name jduel.com www.jduel.com;

    # Frontend static files
    root /var/www/jduel-frontend/dist;
    index index.html;

    # Security headers
    # Note: after running certbot, copy these into the generated HTTPS server block too.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # unsafe-inline required for MUI (emotion CSS-in-JS injects <style> tags at runtime)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self' wss://jduel.com wss://www.jduel.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self';" always;

    # API endpoints -> FastAPI backend
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket -> FastAPI backend
    location /ws {
        proxy_pass http://127.0.0.1:8000;

        # WebSocket upgrade headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Request info
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeouts for WebSocket
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Health check
    location /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Static assets with long-term caching
    # Security headers must be repeated here — nginx add_header is not inherited
    # when a location block defines its own add_header directives.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Social bot preview for room invite links.
    # Detects known social crawler UAs and returns a minimal HTML page with
    # room-specific OG tags. Real browsers fall through to the SPA as normal.
    location ~ ^/room/(?<room_code>[A-Z0-9]{4,6})$ {
        default_type text/html;

        set $preview 0;
        if ($http_user_agent ~* "(Slackbot|Discordbot|TelegramBot|WhatsApp|Twitterbot|facebookexternalhit|facebookcatalog|LinkedInBot|Applebot)") {
            set $preview 1;
        }
        if ($preview) {
            return 200 '<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta property="og:type" content="website"><meta property="og:url" content="https://jduel.com/room/$room_code"><meta property="og:title" content="Join Room $room_code on jDuel"><meta property="og:description" content="You&#x27;ve been invited to a trivia duel. Click to play &#x2014; no account required."><meta property="og:image" content="https://jduel.com/og-image.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Join Room $room_code on jDuel"><meta name="twitter:description" content="You&#x27;ve been invited to a trivia duel. Click to play &#x2014; no account required."><meta name="twitter:image" content="https://jduel.com/og-image.png"><title>Join Room $room_code on jDuel</title></head><body></body></html>';
        }
        try_files $uri $uri/ /index.html;
    }

    # SPA fallback - serves index.html for client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }
}
# Note: Certbot will append an HTTPS server block here when you run:
#   sudo certbot --nginx -d jduel.com -d www.jduel.com
