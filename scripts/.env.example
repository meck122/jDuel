# Copy this file to scripts/.env and fill in your Oracle VM connection details.
# Used by upload-questions.sh to SCP question data to the server.
#
# scripts/.env is gitignored — never commit your actual credentials.

# IP address or hostname of the Oracle VM
JDUEL_SSH_HOST=your-vm-ip-or-hostname

# SSH user (default: ubuntu)
JDUEL_SSH_USER=ubuntu

# Optional: path to SSH private key file.
# Leave commented out if using ssh-agent or a Host entry in ~/.ssh/config.
# JDUEL_SSH_KEY=~/.ssh/jduel.key
